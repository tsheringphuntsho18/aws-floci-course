# NOTE: usms-eks-nodes still reports min=2/max=4/desired=2, NOT the min=2/max=6/desired=3
# this lab's Step 10 intended, because aws eks update-nodegroup-config fails on this build
# with UnknownOperationException (confirmed against known-issues.html). Recorded honestly as
# the value the live API actually returns, not the value the step attempted to set.
export USMS_NODEGROUP_MIN=2
export USMS_NODEGROUP_MAX=4
export USMS_NODEGROUP_DESIRED=2

export USMS_NODE_LABEL_SELECTOR=workload=usms
export USMS_LOADGEN_DEPLOY=usms-loadgen
export USMS_K8S_MANIFEST_DIR_05B=manifests/lab-08
